<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit About</title>
    <link
      href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
      rel="stylesheet"
    />
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
      .social-group {
        border: 1px solid #ddd;
        padding: 12px;
        margin-bottom: 12px;
      }
      .social-group input {
        display: block;
        width: 450px;
        margin-bottom: 8px;
      }
      #editor-container {
        background-color: white;
      }
    </style>
  </head>
  <body>
    <%- include('../partials/admin-navbar') %>

    <h1>Edit About</h1>

    <section style="border: 1px solid #ddd; padding: 20px; margin-bottom: 40px">
      <h2>Bio</h2>
      <form id="aboutForm" action="/about/edit" method="POST">
        <div id="editor-container" style="height: 300px">
          <%- about.description %>
        </div>
        <input type="hidden" name="description" id="description-input" />

        <br />
        <button type="submit">Save Bio</button>
      </form>
    </section>

    <section style="border: 1px solid #ddd; padding: 20px">
      <h2>Social Media</h2>
      <form action="/about/socials" method="POST">
        <div id="social-fields">
          <% socials.forEach(function(s){ %>
          <div class="social-group">
            <input
              name="platform[]"
              value="<%= s.platform %>"
              placeholder="Platform"
            />
            <input
              name="link[]"
              value="<%= s.link %>"
              placeholder="Profile Link"
            />
            <button type="button" onclick="removeSocial(this)">Remove</button>
          </div>
          <% }) %>
        </div>

        <button type="button" id="add-social">+ Add Social Media</button>
        <br /><br />
        <button type="submit">Save Social Media</button>
      </form>
    </section>

    <script>
      // Bio WYSIWYG Text Editor
      var quill = new Quill('#editor-container', {
        theme: 'snow',
        modules: {
          toolbar: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline'],
            ['link', 'blockquote', 'code-block'],
            [{ list: 'ordered' }, { list: 'bullet' }],
            ['clean'],
          ],
        },
      });

      var form = document.getElementById('aboutForm');
      form.onsubmit = function () {
        var descriptionInput = document.getElementById('description-input');
        descriptionInput.value = quill.root.innerHTML;
        return true;
      };

      // Social Media Dynamic Fields Logic
      const container = document.getElementById('social-fields');
      document
        .getElementById('add-social')
        .addEventListener('click', function () {
          const wrapper = document.createElement('div');
          wrapper.className = 'social-group';
          wrapper.innerHTML = `
            <input name="platform[]" placeholder="Platform" />
            <input name="link[]" placeholder="Profile Link" />
            <button type="button" onclick="removeSocial(this)">Remove</button>
        `;
          container.appendChild(wrapper);
        });

      function removeSocial(btn) {
        btn.parentElement.remove();
      }
    </script>
  </body>
</html>
