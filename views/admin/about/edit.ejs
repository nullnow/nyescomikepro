<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nyesco | Edit About</title>
    <link
      href="https://cdn.quilljs.com/1.3.6/quill.snow.css"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              nyesco: {
                dark: '#0f172a', // Kept for text/buttons
                accent: '#ffffff', // Now the primary background
                muted: '#64748b',
                border: '#e2e8f0', // Lighter border for light mode
              },
            },
          },
        },
      };
    </script>

    <style>
      /* Adjusted Quill for light theme */
      .ql-toolbar.ql-snow {
        @apply bg-slate-50 border-slate-200 rounded-t-lg;
      }
      .ql-container.ql-snow {
        @apply border-slate-200 bg-white text-slate-900 rounded-b-lg;
      }
      .social-group input::placeholder {
        @apply text-slate-400;
      }
    </style>
  </head>

  <body class="bg-white text-nyesco-dark font-sans antialiased min-h-screen">
    <%- include('../../partials/admin-navbar') %>

    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="flex items-center gap-6 mb-12">
        <h1
          class="text-4xl font-bold tracking-tighter uppercase italic text-slate-900"
        >
          Edit About
        </h1>
      </div>

      <!-- Identity & Bio Section -->
      <section
        class="bg-white border border-slate-200 p-8 rounded-sm mb-10 relative overflow-hidden shadow-sm"
      >
        <div class="absolute top-0 left-0 w-1 h-full bg-slate-900"></div>
        <h2
          class="text-xs font-black uppercase tracking-[0.3em] text-nyesco-muted mb-8"
        >
          Identity & Bio
        </h2>

        <form
          id="aboutForm"
          action="/about/edit"
          method="POST"
          class="space-y-6"
        >
          <!-- Using the TinyMCE/Quill container field -->
          <div
            id="editor-container"
            class="h-80 shadow-inner border border-slate-200"
          >
            <%- about.description %>
          </div>
          <input type="hidden" name="description" id="description-input" />

          <div class="flex justify-end">
            <button
              type="submit"
              class="bg-slate-900 text-white px-10 py-3 font-black uppercase tracking-widest text-xs hover:bg-slate-800 transition-all transform hover:-translate-y-1"
            >
              Save Bio
            </button>
          </div>
        </form>
      </section>

      <!-- Digital Footprint / Socials Section -->
      <section
        class="bg-slate-50 border border-slate-200 p-8 rounded-sm shadow-sm"
      >
        <h2
          class="text-xs font-black uppercase tracking-[0.3em] text-nyesco-muted mb-8"
        >
          Digital Footprint
        </h2>

        <form action="/about/socials" method="POST" class="space-y-8">
          <div id="social-fields" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% socials.forEach(function(s){ %>
            <div
              class="group bg-white border border-slate-200 p-6 rounded-sm relative shadow-sm"
            >
              <input
                name="platform[]"
                value="<%= s.platform %>"
                placeholder="PLATFORM"
                class="w-full bg-transparent border-b border-slate-200 py-2 mb-4 focus:border-slate-900 outline-none text-sm font-bold tracking-wide"
              />
              <input
                name="link[]"
                value="<%= s.link %>"
                placeholder="PROFILE URL"
                class="w-full bg-transparent border-b border-slate-200 py-2 focus:border-slate-900 outline-none text-xs text-nyesco-muted"
              />
              <button
                type="button"
                onclick="removeSocial(this)"
                class="mt-4 text-[10px] uppercase font-bold text-red-600 hover:text-red-500 tracking-tighter opacity-0 group-hover:opacity-100 transition-opacity"
              >
                [ Remove Entry ]
              </button>
            </div>
            <% }) %>
          </div>

          <div
            class="flex items-center justify-between pt-6 border-t border-slate-200"
          >
            <button
              type="button"
              id="add-social"
              class="text-xs font-bold uppercase tracking-widest border border-slate-300 px-4 py-2 hover:border-slate-900 hover:text-slate-900 transition-all"
            >
              + Add Social
            </button>
            <button
              type="submit"
              class="bg-slate-900 text-white px-10 py-3 font-black uppercase tracking-widest text-xs hover:bg-slate-800 transition-all transform hover:-translate-y-1 shadow-lg"
            >
              Update Social Media
            </button>
          </div>
        </form>
      </section>
    </div>

    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
      var quill = new Quill('#editor-container', {
        theme: 'snow',
        modules: {
          toolbar: [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic'],
            ['link', 'blockquote', 'code-block'],
            [{ list: 'ordered' }, { list: 'bullet' }],
          ],
        },
      });

      var form = document.getElementById('aboutForm');
      form.onsubmit = function () {
        var descriptionInput = document.getElementById('description-input');
        descriptionInput.value = quill.root.innerHTML;
        return true;
      };

      const container = document.getElementById('social-fields');
      document
        .getElementById('add-social')
        .addEventListener('click', function () {
          const wrapper = document.createElement('div');
          wrapper.className =
            'group bg-white border border-slate-200 p-6 rounded-sm relative shadow-sm';
          wrapper.innerHTML = `
            <input name="platform[]" placeholder="PLATFORM" class="w-full bg-transparent border-b border-slate-200 py-2 mb-4 focus:border-slate-900 outline-none text-sm font-bold tracking-wide" />
            <input name="link[]" placeholder="PROFILE URL" class="w-full bg-transparent border-b border-slate-200 py-2 focus:border-slate-900 outline-none text-xs text-slate-500" />
            <button type="button" onclick="removeSocial(this)" class="mt-4 text-[10px] uppercase font-bold text-red-600 hover:text-red-500 tracking-tighter opacity-0 group-hover:opacity-100 transition-opacity">
              [ Remove Entry ]
            </button>
        `;
          container.appendChild(wrapper);
        });

      function removeSocial(btn) {
        btn.parentElement.remove();
      }
    </script>
  </body>
</html>
