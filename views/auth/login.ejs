<!DOCTYPE html>
<html>
  <head>
    <title>Login</title>
  </head>

  <body>
    <h1>Login</h1>

    <form method="POST" action="/login">
      <div>
        <label>Username</label>

        <input type="text" name="username" required />
      </div>

      <br />

      <div>
        <label>Password</label>

        <input type="password" name="password" required />
      </div>

      <br />

      <button type="submit">Login</button>
    </form>
  </body>
</html>
