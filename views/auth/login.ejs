<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nyesco | Authentication</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              nyesco: {
                dark: '#0f172a',
                accent: '#f8fafc',
                muted: '#64748b',
                border: '#334155',
              },
            },
          },
        },
      };
    </script>
  </head>

  <body
    class="bg-nyesco-dark text-nyesco-accent font-sans antialiased min-h-screen flex items-center justify-center p-6"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-[-10%] right-[-5%] w-[40%] h-[40%] border border-nyesco-border/20 rounded-full"
      ></div>
      <div
        class="absolute bottom-[-5%] left-[-5%] w-[30%] h-[30%] border border-nyesco-border/10 rotate-45"
      ></div>
    </div>

    <div class="w-full max-w-md relative">
      <div class="flex flex-col items-center mb-10">
        <div
          class="h-20 w-20 bg-nyesco-accent p-3 mb-6 shadow-[6px_6px_0px_0px_rgba(51,65,85,1)]"
        >
          <img
            src="/nyesco-logo.png"
            alt="Nyesco Logo"
            class="w-full h-full object-contain brightness-0"
          />
        </div>
        <h1
          class="text-xs font-black uppercase tracking-[0.5em] text-nyesco-muted text-center"
        >
          Dashboard Access
        </h1>
      </div>

      <section
        class="bg-slate-900/60 backdrop-blur-md border border-nyesco-border p-10 rounded-sm shadow-2xl"
      >
        <form method="POST" action="/login" class="space-y-8">
          <div class="space-y-2 group">
            <label
              class="text-[10px] font-bold uppercase tracking-widest text-nyesco-muted group-focus-within:text-nyesco-accent transition-colors"
            >
              Username
            </label>
            <input
              type="text"
              name="username"
              required
              placeholder="USERNAME"
              class="w-full bg-nyesco-dark/50 border border-nyesco-border p-4 outline-none focus:border-nyesco-accent transition-all text-nyesco-accent text-sm tracking-widest placeholder:text-nyesco-muted/30"
            />
          </div>

          <div class="space-y-2 group">
            <label
              class="text-[10px] font-bold uppercase tracking-widest text-nyesco-muted group-focus-within:text-nyesco-accent transition-colors"
            >
              Password
            </label>

            <div class="relative">
              <input
                id="password-input"
                type="password"
                name="password"
                required
                placeholder="••••••••"
                class="w-full bg-nyesco-dark/50 border border-nyesco-border p-4 pr-12 outline-none focus:border-nyesco-accent transition-all text-nyesco-accent text-sm tracking-[0.5em] placeholder:tracking-normal placeholder:text-nyesco-muted/30"
              />

              <button
                type="button"
                onclick="togglePassword()"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-nyesco-muted hover:text-nyesco-accent transition-colors focus:outline-none"
              >
                <svg
                  id="eye-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>

                <svg
                  id="eye-off-icon"
                  class="hidden"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
                  <path
                    d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
                  />
                  <path
                    d="M6.61 6.61A13.52 13.52 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
                  />
                  <line x1="2" y1="2" x2="22" y2="22" />
                </svg>
              </button>
            </div>
          </div>

          <div class="pt-4">
            <button
              type="submit"
              class="w-full bg-nyesco-accent text-nyesco-dark py-4 font-black uppercase tracking-[0.3em] text-xs hover:bg-white transition-all shadow-[4px_4px_0px_0px_rgba(51,65,85,1)] active:translate-y-1 active:shadow-none"
            >
              SIGN IN
            </button>
          </div>
        </form>

        <div class="mt-8 text-center">
          <a
            href="/"
            class="text-[10px] uppercase font-bold text-nyesco-muted hover:text-nyesco-accent transition-colors tracking-widest"
          >
            ← Back to Homepage
          </a>
        </div>
      </section>
    </div>

    <script>
      function togglePassword() {
        const passwordInput = document.getElementById('password-input');
        const eyeIcon = document.getElementById('eye-icon');
        const eyeOffIcon = document.getElementById('eye-off-icon');

        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          // Adjust tracking for readable text
          passwordInput.classList.remove('tracking-[0.5em]');
          passwordInput.classList.add('tracking-widest');

          // Toggle Icons
          eyeIcon.classList.add('hidden');
          eyeOffIcon.classList.remove('hidden');
        } else {
          passwordInput.type = 'password';
          // Return to masked tracking
          passwordInput.classList.remove('tracking-widest');
          passwordInput.classList.add('tracking-[0.5em]');

          // Toggle Icons
          eyeIcon.classList.remove('hidden');
          eyeOffIcon.classList.add('hidden');
        }
      }
    </script>
  </body>
</html>
